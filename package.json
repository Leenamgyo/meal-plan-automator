{
  "name": "meal-chart",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "dist-server/main.js",
  "scripts": {
    "dev": "vite dev",
    "build:server": "tsc -p tsconfig.server.json && echo '{\"type\":\"commonjs\"}' > dist-server/package.json && mkdir -p dist-server/server/seed/prompts && cp server/seed/prompts/*.md dist-server/server/seed/prompts/",
    "build:client": "vite build && sed -i '' 's/\"\\/_app/\"\\.\\/_app/g' build/index.html && sed -i '' 's/href=\"\\/_app/href=\"\\.\\/_app/g' build/index.html",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"server/**/*.test.ts\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.27",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.8",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@graphql-tools/schema": "^10.0.33",
    "better-sqlite3": "^12.6.2",
    "graphql": "^16.13.2",
    "graphql-http": "^1.22.4",
    "html2canvas": "^1.4.1"
  }
}
